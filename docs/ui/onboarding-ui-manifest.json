{
  "version": 1,
  "product": "Atlas",
  "flow": "onboarding",
  "design": {
    "style": "clean mobile wellness",
    "background": "#FFFFFF",
    "primary": "#4E86F7",
    "primaryPressed": "#3F76E8",
    "border": "#E6ECF5",
    "textPrimary": "#111827",
    "textSecondary": "#6B7280",
    "radiusButton": 14,
    "radiusCard": 22,
    "screenPadding": 24,
    "ctaHeight": 50
  },
  "rules": [
    "one primary question per screen",
    "large bottom CTA",
    "single-column option layout by default",
    "progress indicator visible on all non-splash screens",
    "health data connection should appear late",
    "rating prompt is excluded from first-run flow",
    "privacy/discreet mode must appear before health connection"
  ],
  "sharedComponents": [
    "OnboardingScaffold",
    "ProgressHeader",
    "AnswerOptionButton",
    "MultiSelectOptionButton",
    "BottomCTA",
    "HeaderBackButton",
    "UnitToggle",
    "WheelPickerField",
    "SummaryCard",
    "PermissionCard"
  ],
  "branches": {
    "entryChoice": ["glp", "peptide", "both", "later"],
    "glp": [
      "glpMedication",
      "glpFrequency",
      "glpInjectionDay",
      "glpCurrentDose",
      "glpDuration",
      "glpMainGoal",
      "glpBiggestChallenge"
    ],
    "peptide": [
      "peptideSelection",
      "peptideFrequency",
      "peptideExperience",
      "peptideUsualTime",
      "peptideCurrentDose",
      "peptideMainGoal"
    ],
    "both": [
      "glpMedication",
      "glpFrequency",
      "glpInjectionDay",
      "glpCurrentDose",
      "glpDuration",
      "glpMainGoal",
      "glpBiggestChallenge",
      "peptideSelection",
      "peptideFrequency",
      "peptideExperience",
      "peptideUsualTime",
      "peptideCurrentDose",
      "peptideMainGoal"
    ]
  },
  "screens": [
    {
      "id": "splash",
      "type": "branding",
      "title": "Atlas",
      "primaryAction": "continue"
    },
    {
      "id": "intro",
      "type": "valueProp",
      "title": "All your tracking in one place",
      "primaryAction": "getStarted",
      "secondaryAction": "signIn"
    },
    {
      "id": "accountMode",
      "type": "singleSelect",
      "title": "How do you want to start?",
      "options": ["Continue as guest", "Create account", "Sign in"]
    },
    {
      "id": "privacyMode",
      "type": "multiToggle",
      "title": "Choose your privacy settings",
      "options": [
        "Discreet notifications",
        "Hide sensitive labels",
        "Use biometric lock later",
        "Share anonymous analytics"
      ]
    },
    {
      "id": "trackType",
      "type": "singleSelect",
      "title": "What are you tracking?",
      "options": ["GLP", "Peptide", "Both", "Explore first"]
    },
    {
      "id": "gender",
      "type": "singleSelectOptional",
      "title": "Select your gender",
      "options": ["Male", "Female", "Other", "Skip"]
    },
    {
      "id": "age",
      "type": "wheelPickerOptional",
      "title": "How old are you?"
    },
    {
      "id": "goalWeight",
      "type": "wheelPickerOptional",
      "title": "What's your goal weight?"
    },
    {
      "id": "heightWeight",
      "type": "dualMetricOptional",
      "title": "What's your current height and weight?"
    },
    {
      "id": "connectApps",
      "type": "permission",
      "title": "Connect your health apps",
      "options": ["Apple Health / Health Connect"],
      "secondaryAction": "notNow"
    },
    {
      "id": "planReady",
      "type": "summary",
      "title": "Your tracking plan is ready",
      "primaryAction": "letsGetStarted"
    }
  ],
  "outputShape": {
    "accountMode": "guest | create | signIn",
    "privacy": {
      "discreetNotifications": "boolean",
      "hideSensitiveLabels": "boolean",
      "biometricLater": "boolean",
      "analyticsOptIn": "boolean"
    },
    "trackType": "glp | peptide | both | later",
    "profile": {
      "gender": "string | null",
      "age": "number | null",
      "goalWeight": "number | null",
      "height": "number | null",
      "heightUnit": "cm | ft_in | null",
      "weight": "number | null",
      "weightUnit": "kg | lb | null"
    },
    "glp": {
      "medication": "string | null",
      "frequency": "string | null",
      "injectionDay": "string | null",
      "dose": "string | null",
      "duration": "string | null",
      "goal": "string | null",
      "challenge": "string | null"
    },
    "peptide": {
      "selections": "string[]",
      "frequency": "string | null",
      "experience": "string | null",
      "usualTime": "string | null",
      "dose": "string | null",
      "goal": "string | null"
    },
    "healthConnectionPromptSeen": "boolean"
  }
}
